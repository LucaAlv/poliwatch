  "cards": [
    {
      "dot": "cyan",
      "title": "Build path",
      "items": [
        "Per sitting: XML transcript, DIP joins, roll-call scrape, then data/*.json and SQLite.",
        "Fakten runs before the distribution export and static page render.",
        "--offline reuses cached JSON; an unchanged export reuses its generation."
      ]
    },
    {
      "dot": "amber",
      "title": "Sources and failure modes",
      "items": [
        "DIP uses an API key and cursor paging; roll calls use Bundestag HTML.",
        "abgeordnetenwatch throttles; optional LLM summaries send excerpts out.",
        "Public components are fixed; optional acquisitions report their state."
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Keys stay in gitignored .env.local; the preview binds 127.0.0.1 by default.",
        "datenstand.json selects g-<hash>/; --data-manifest can select a local file or URL.",
        "The published site includes data/exports/; the browser reads static pages."
      ]
    }
  ]
}
