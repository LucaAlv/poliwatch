  "cards": [
    {
      "dot": "cyan",
      "title": "Build path",
      "items": [
        "update sources .env.local, then hands flags to the builder.",
        "Per sitting: XML transcript, DIP joins, roll-call scrape.",
        "Builder writes data/*.json, rebuilds SQLite, renders pages.",
        "Default mode is --offline: cached JSON in, no network calls.",
        "Offline re-renders only; it never re-derives rows."
      ]
    },
    {
      "dot": "amber",
      "title": "Sources and failure modes",
      "items": [
        "DIP: apikey in the query, cursor paging, 429/5xx retries.",
        "Roll calls are scraped from bundestag.de HTML; drift only warns.",
        "abgeordnetenwatch throttles and trips a breaker; build survives.",
        "Votes, summaries, profiles, MP pages: Bausteine, off by default.",
        "features.json → local → env → --features → --enable/--disable."
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Keys stay in gitignored .env.local; DIP and the LLM see them.",
        "Summaries send transcript excerpts out; reuse mode calls nothing.",
        "Binds 127.0.0.1; PREVIEW_BIND=0.0.0.0 widens it deliberately.",
        "data/ ships with the pages — publishing publishes the cache.",
        "Browser state is localStorage only; no client-side fetch."
      ]
    }
  ]
