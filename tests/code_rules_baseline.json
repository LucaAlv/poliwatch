  "nullable_comparisons": [
    {
      "file": "scripts/build_dip_pulse_site.py",
      "function": "_fact_speech_citation",
      "comparison": "speeches.rede_id = ?",
      "reason": "Runs only behind `if rede_id:`, so the bound value is never None; a speech without a rede id is cited by its speech id instead."
    },
    {
      "file": "scripts/build_dip_pulse_site.py",
      "function": "_fact_vote_citation",
      "comparison": "votes.detail_url = ?",
      "reason": "official_url is checked non-empty just above, so the bound value is never None; a vote without a detail_url cannot be the one a URL cites."
    },
    {
      "file": "scripts/persist_dip_pulse_store.py",
      "function": "require_current_speech_rules",
      "comparison": "speech_rule_inputs.version != ?",
      "reason": "Binds the constant speech_kinds.VERSION; a NULL version is caught by the `r.version IS NULL OR` branch of the same WHERE."
    },
    {
      "file": "scripts/persist_dip_pulse_store.py",
      "function": "_repoint_party",
      "comparison": "mps.party_id = ?",
      "reason": "Binds old_id, the id of an existing parties row being merged away, never None; a row without a party (NULL) must not be repointed."
    },
    {
      "file": "scripts/persist_dip_pulse_store.py",
      "function": "_repoint_party",
      "comparison": "vote_members.party_id = ?",
      "reason": "Binds old_id, the id of an existing parties row being merged away, never None; a row without a party (NULL) must not be repointed."
    },
    {
      "file": "scripts/persist_dip_pulse_store.py",
      "function": "_repoint_party",
      "comparison": "vote_members.listed_party_id = ?",
      "reason": "Binds old_id, the id of an existing parties row being merged away, never None; a row without a party (NULL) must not be repointed."
    },
    {
      "file": "scripts/persist_dip_pulse_store.py",
      "function": "persist_report",
      "comparison": "votes.protocol_id = ?",
      "reason": "Binds protocol_id, which persist_report refuses when empty; a vote without a protocol is not this report's."
    },
    {
      "file": "scripts/stammdaten.py",
      "function": "crosscheck",
      "comparison": "mdb_zugehoerigkeiten.valid_until = ?",
      "reason": "Binds the vote's date, already compared with stand_day above, so never None; an open membership (NULL valid_until) has no change on that day, so leaving it out is intended."
    }
